# Local development only. Copy to .env and replace shared secrets.
COMPOSE_PROJECT_NAME=labops
LABOPS_SECRET_KEY=replace-with-a-random-secret-before-use
LABOPS_DEBUG=1
LABOPS_ALLOWED_HOSTS=localhost,127.0.0.1,web,testserver
POSTGRES_DB=labops
POSTGRES_USER=labops
POSTGRES_PASSWORD=labops-local
POSTGRES_PORT=55433
DB_CONNECT_TIMEOUT_SECONDS=5
WEB_PORT=8001
WEB_CONCURRENCY=2
METRICS_TOKEN=local-metrics-change-me
GRAFANA_ADMIN_PASSWORD=local-grafana-change-me
# Keep local unless the full events profile is started.
LABOPS_EVENT_TRANSPORT=local
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_TOPIC=labops.inventory.v1
KAFKA_DLQ_TOPIC=labops.inventory.dlq.v1
# Development plaintext must stay on a private/loopback network. Production
# KAFKA_REQUIRE_SECURITY=1 requires SASL_SSL, a trusted CA, and role secret files.
KAFKA_REQUIRE_SECURITY=0
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SSL_CA_LOCATION=
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD_FILE=
KAFKA_PUBLISHER_SASL_USERNAME=
KAFKA_PUBLISHER_SASL_PASSWORD_FILE=
KAFKA_NOTIFICATION_SASL_USERNAME=
KAFKA_NOTIFICATION_SASL_PASSWORD_FILE=
KAFKA_ANALYTICS_SASL_USERNAME=
KAFKA_ANALYTICS_SASL_PASSWORD_FILE=
KAFKA_DLQ_SASL_USERNAME=
KAFKA_DLQ_SASL_PASSWORD_FILE=
KAFKA_ADMIN_SASL_USERNAME=
KAFKA_ADMIN_SASL_PASSWORD_FILE=
KAFKA_EXPORTER_SASL_USERNAME=
KAFKA_EXPORTER_SASL_PASSWORD_FILE=
KAFKA_REPLAY_SASL_USERNAME=
KAFKA_REPLAY_SASL_PASSWORD_FILE=
KAFKA_GROUP_PREFIX=labops
KAFKA_SOURCE_CLUSTER_ID=dev-local
KAFKA_SOURCE_STREAM_GENERATION=1
KAFKA_DELIVERY_TIMEOUT_MS=10000
KAFKA_REQUEST_TIMEOUT_MS=5000
KAFKA_PRODUCER_RETRIES=1000000
KAFKA_RETRY_BACKOFF_MS=100
KAFKA_QUEUE_MAX_MESSAGES=10000
KAFKA_QUEUE_MAX_KBYTES=16384
KAFKA_PRODUCER_QUEUE_WAIT_SECONDS=2
KAFKA_PUBLISH_FLUSH_SECONDS=12
EVENT_PUBLISH_DB_BUDGET_SECONDS=5
EVENT_LEASE_SECONDS=60
EVENT_PUBLISHER_SHARD_COUNT=1
EVENT_PUBLISHER_SHARD_INDEX=0
EVENT_RETRY_SECONDS=60,300,900,3600
EVENT_RETRY_JITTER=0.2
EVENT_RETRY_LOCK_TIMEOUT_MS=5000
EVENT_RETRY_STATEMENT_TIMEOUT_MS=30000
EVENT_MAX_PAYLOAD_BYTES=262144
KAFKA_MESSAGE_MAX_BYTES=1048576
KAFKA_DLQ_MESSAGE_MAX_BYTES=2097152
KAFKA_MAX_POLL_INTERVAL_MS=300000
KAFKA_SESSION_TIMEOUT_MS=10000
KAFKA_HEARTBEAT_INTERVAL_MS=3000
KAFKA_SOCKET_TIMEOUT_MS=5000
KAFKA_CONSUMER_PROCESS_TIMEOUT_SECONDS=30
WORKER_SHUTDOWN_TIMEOUT_SECONDS=45
# Each worker container binds its own 9100. Never publish this port to the host.
WORKER_METRICS_ENABLED=1
WORKER_METRICS_HOST=0.0.0.0
WORKER_METRICS_PORT=9100
WORKER_METRICS_TOKEN=local-worker-metrics-change-me
WORKER_METRICS_TOKEN_FILE=
KAFKA_EXTERNAL_PORT=19093
REDPANDA_ADMIN_PORT=19645
# Set redis://redis:6379/0 only with the redis profile.
REDIS_URL=
REDIS_PORT=16380
# Set http://otel-collector:4318 only with the observability profile.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=labops
PROMETHEUS_PORT=19090
GRAFANA_PORT=13000
JAEGER_PORT=16687
