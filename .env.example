# Local development only. Copy to .env and replace shared secrets.
COMPOSE_PROJECT_NAME=labops
LABOPS_SECRET_KEY=replace-with-a-random-secret-before-use
LABOPS_DEBUG=1
LABOPS_ALLOWED_HOSTS=localhost,127.0.0.1,web,testserver
POSTGRES_DB=labops
POSTGRES_USER=labops
POSTGRES_PASSWORD=labops-local
POSTGRES_PORT=55433
WEB_PORT=8001
WEB_CONCURRENCY=2
METRICS_TOKEN=local-metrics-change-me
GRAFANA_ADMIN_PASSWORD=local-grafana-change-me
# Keep local unless the full events profile is started.
LABOPS_EVENT_TRANSPORT=local
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_TOPIC=labops.inventory.v1
KAFKA_DLQ_TOPIC=labops.inventory.dlq.v1
KAFKA_EXTERNAL_PORT=19093
REDPANDA_ADMIN_PORT=19645
# Set redis://redis:6379/0 only with the redis profile.
REDIS_URL=
REDIS_PORT=16380
# Set http://otel-collector:4318 only with the observability profile.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=labops
PROMETHEUS_PORT=19090
GRAFANA_PORT=13000
JAEGER_PORT=16687
